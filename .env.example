# OpenRouter API Key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Firebase Service Account — provide ONE of the following:
# Option 1 (recommended for cloud deploys like Railway): raw JSON content of the service account file
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Option 2: path to a local JSON file (used if Option 1 is unset)
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
# Option 3 (local dev): place the file at src/main/resources/firebase-service-account.json (git-ignored)
