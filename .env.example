# Primary LLM — Google Gemini free tier (key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Fallback LLM — Groq free tier (key: https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# Firebase Service Account — provide ONE of the following:
# Option 1 (recommended for cloud deploys like Render): raw JSON content of the service account file
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Option 2: path to a local JSON file (used if Option 1 is unset)
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
# Option 3 (local dev): place the file at src/main/resources/firebase-service-account.json (git-ignored)

# Email OTP via Gmail SMTP (free, no card, no custom domain).
# 1. Turn on 2-Step Verification on the Gmail account.
# 2. Create an App Password: Google Account -> Security -> App passwords.
# 3. Put the address + 16-character app password below, set OTP_ENABLED=true.
OTP_ENABLED=false
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
